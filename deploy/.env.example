BACKEND_IMAGE=microgrid-backend:20260403
FRONTEND_IMAGE=microgrid-frontend:20260403

BACKEND_PORT=6001
FRONTEND_PORT=8081

CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
REPORT_TEMPLATE_DIR=/opt/docker/pre-sale/report_templates

GEOCODER_DEFAULT_REGION=us
GEOCODER_API_URL=http://host.docker.internal:4000/v1/search
GEOCODER_REVERSE_API_URL=http://host.docker.internal:4000/v1/reverse
GEOCODER_API_URL_CN=http://host.docker.internal:4000/v1/search
GEOCODER_REVERSE_API_URL_CN=http://host.docker.internal:4000/v1/reverse
GEOCODER_API_URL_US=http://host.docker.internal:4000/v1/search
GEOCODER_REVERSE_API_URL_US=http://host.docker.internal:4000/v1/reverse

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
INTERNAL_REPORT_EMAIL_DOMAINS=example.com
INTERNAL_REPORT_EMAILS=
